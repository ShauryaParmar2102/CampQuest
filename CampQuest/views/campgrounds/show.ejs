<% layout('layouts/boilerplate') %>

<link rel="stylesheet" href="/stylesheets/stars.css">

<div class="row">

    <!-- Left side: campground details -->
    <div class="col-6">

        <!-- Image carousel -->
        <% if (camp.images.length) { %>

            <div id="carouselImage" class="carousel slide" data-ride="carousel">

                <ol class="carousel-indicators">

                    <% for (let i = 0; i < camp.images.length; i++) { %>

                        <li 
                            data-target="#carouselImage"
                            data-slide-to="<%= i %>"
                            class="<%= i === 0 ? 'active' : '' %>">
                        </li>

                    <% } %>

                </ol>

                <div class="carousel-inner">

                    <% for (let i = 0; i < camp.images.length; i++) { %>

                        <div class="carousel-item <%= i === 0 ? 'active' : '' %>">

                            <img
                                src="<%= camp.images[i].url %>"
                                class="d-block w-100"
                                alt="<%= camp.title %>"
                            >

                        </div>

                    <% } %>

                </div>

                <% if (camp.images.length > 1) { %>

                    <a class="carousel-control-prev" href="#carouselImage" role="button" data-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                        <span class="sr-only">Previous</span>
                    </a>

                    <a class="carousel-control-next" href="#carouselImage" role="button" data-slide="next">
                        <span class="carousel-control-next-icon"></span>
                        <span class="sr-only">Next</span>
                    </a>

                <% } %>

            </div>

        <% } else { %>

            <div class="p-4 text-muted">
                No image available
            </div>

        <% } %>


        <!-- Campground information -->
        <div class="card mb-3">

            <div class="card-body">

                <h5 class="card-title">
                    <%= camp.title %>
                </h5>

                <p class="card-text">
                    <%= camp.description %>
                </p>

            </div>

            <ul class="list-group list-group-flush">

                <li class="list-group-item text-muted">
                    <%= camp.location %>
                </li>

                <li class="list-group-item">

                    <% if (camp.author) { %>

                        Added by:
                        <%= camp.author.username %>

                    <% } else { %>

                        Added by: Seed Data

                    <% } %>

                </li>

                <li class="list-group-item">
                    $<%= camp.price %> per night
                </li>

            </ul>


            <!-- Edit/Delete buttons for campground owner -->
            <% if (
                currentUser &&
                camp.author &&
                currentUser._id.equals(camp.author._id)
            ) { %>

                <div class="card-body">

                    <a
                        href="/campgrounds/<%= camp._id %>/edit"
                        class="btn btn-info">
                        Edit Campground
                    </a>

                    <form
                        class="d-inline"
                        action="/campgrounds/<%= camp._id %>?_method=DELETE"
                        method="POST">

                        <button class="btn btn-danger">
                            Delete Campground
                        </button>

                    </form>

                </div>

            <% } %>


            <% if (!currentUser) { %>

                <div class="card-footer text-muted">
                    Author of this campground? Login to edit!
                </div>

            <% } %>

        </div>

    </div>


    <!-- Right side: reviews -->
    <div class="col-6">

        <% if (!currentUser) { %>

            <div class="mb-3 text-muted">
                <h5>Sign up or login to add a review!</h5>
            </div>

        <% } %>


        <% if (currentUser) { %>

            <h4>Leave a Review!</h4>

            <form
                action="/campgrounds/<%= camp._id %>/reviews"
                method="POST"
                class="mb-3 needs-validation"
                novalidate>

                <!-- Star rating -->
                <fieldset class="starability-checkmark">

                    <input
                        type="radio"
                        id="no-rate"
                        class="input-no-rate"
                        name="reviews[rating]"
                        value="5"
                        checked
                    >

                    <input type="radio" id="first-rate1" name="reviews[rating]" value="1">
                    <label for="first-rate1">1 star</label>

                    <input type="radio" id="first-rate2" name="reviews[rating]" value="2">
                    <label for="first-rate2">2 stars</label>

                    <input type="radio" id="first-rate3" name="reviews[rating]" value="3">
                    <label for="first-rate3">3 stars</label>

                    <input type="radio" id="first-rate4" name="reviews[rating]" value="4">
                    <label for="first-rate4">4 stars</label>

                    <input type="radio" id="first-rate5" name="reviews[rating]" value="5">
                    <label for="first-rate5">5 stars</label>

                </fieldset>


                <!-- Review text -->
                <div class="mb-3">

                    <label for="body">
                        Review text:
                    </label>

                    <textarea
                        class="form-control"
                        name="reviews[body]"
                        id="body"
                        required>
                    </textarea>

                </div>

                <button class="btn btn-success">
                    Submit
                </button>

            </form>

        <% } %>


        <!-- Display reviews -->
        <% for (let review of camp.reviews) { %>

            <div class="card mb-3">

                <div class="card-body">

                <% if (review.author) { %>

                    <!-- Display the username of the person who wrote the review -->
                    <p class="text-muted mb-2">
                        Reviewed by <strong><%= review.author.username %></strong>
                    </p>

                <% } %>

                    <p class="card-text">
                        <%= review.body %>
                    </p>

                    <p
                        class="starability-result"
                        data-rating="<%= review.rating %>">

                        Rated: <%= review.rating %> stars

                    </p>


                    <% if (
                        currentUser &&
                        review.author &&
                        currentUser._id.equals(review.author._id)
                    ) { %>

                        <form
                            action="/campgrounds/<%= camp._id %>/reviews/<%= review._id %>?_method=DELETE"
                            method="POST">

                            <button class="btn btn-sm btn-danger">
                                Delete Review
                            </button>

                        </form>

                    <% } %>

                </div>

            </div>

        <% } %>

    </div>

</div>