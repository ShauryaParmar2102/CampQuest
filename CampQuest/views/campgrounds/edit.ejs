<% layout('layouts/boilerplate') %> 

<!-- Edit campground page -->
<div class="row">

    <div class="col-md-6 offset-md-3">

        <h1 class="text-center">Edit Campground</h1>

        <!-- Send the updated campground data using a PUT request -->
        <form 
            action="/campgrounds/<%= camp._id %>?_method=PUT" 
            method="POST" 
            novalidate 
            class="needs-validation" 
            enctype="multipart/form-data"
        >

            <!-- Campground name -->
            <div class="mb-3">
                <label class="form-label" for="title">Name:</label>

                <input 
                    class="form-control" 
                    type="text" 
                    name="campgrounds[title]" 
                    id="title" 
                    value="<%= camp.title %>" 
                    required
                >

                <div class="invalid-feedback">
                    Please enter a campground name.
                </div>
            </div>


            <!-- Campground location -->
            <div class="mb-3">
                <label class="form-label" for="location">City and State:</label>

                <input 
                    class="form-control" 
                    type="text" 
                    name="campgrounds[location]" 
                    id="location" 
                    value="<%= camp.location %>" 
                    required
                >

                <div class="invalid-feedback">
                    Please enter a location.
                </div>
            </div>


            <!-- Price per night -->
            <div class="mb-3">
                <label class="form-label" for="price">Price per night:</label>

                <div class="input-group">

                    <div class="input-group-prepend">
                        <span class="input-group-text">$</span>
                    </div>

                    <input 
                        type="number" 
                        class="form-control" 
                        id="price"
                        name="campgrounds[price]"
                        value="<%= camp.price %>"
                        min="0"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a valid price.
                    </div>

                </div>
            </div>


            <!-- Campground description -->
            <div class="mb-3">
                <label class="form-label" for="description">Description:</label>

                <textarea 
                    class="form-control" 
                    name="campgrounds[description]" 
                    id="description" 
                    required
                ><%= camp.description %></textarea>

                <div class="invalid-feedback">
                    Please enter a description.
                </div>
            </div>


            <!-- Upload additional campground images -->
            <div class="mb-3">

                <div class="custom-file">

                    <input 
                        type="file" 
                        class="custom-file-input" 
                        id="image" 
                        name="image" 
                        multiple
                    >

                    <label class="custom-file-label" for="image">
                        Add More Image(s)
                    </label>

                </div>
            </div>


            <!-- Display existing images and allow them to be deleted -->
            <div class="mb-3">

                <% for (let i = 0; i < camp.images.length; i++) { %> 

                    <img 
                        src="<%= camp.images[i].thumbnail %>" 
                        class="img-thumbnail" 
                        alt="<%= camp.title %>"
                    >

                    <div class="form-check-inline">

                        <input 
                            type="checkbox" 
                            id="image-<%= i %>" 
                            name="deleteImages[]" 
                            value="<%= camp.images[i].filename %>"
                        >

                    </div>

                    <label for="image-<%= i %>">
                        Delete?
                    </label>

                <% } %> 

            </div>


            <!-- Update campground -->
            <div class="mb-3">
                <button class="btn btn-success">
                    Update Campground
                </button>
            </div>

        </form>

        <!-- Return to campground details -->
        <a href="/campgrounds/<%= camp._id %>">
            Back To Campground
        </a>

    </div>

</div>