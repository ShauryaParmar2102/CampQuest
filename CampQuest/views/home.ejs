<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CampQuest</title>

    <!-- Bootstrap 4.6 -->
    <link 
        rel="stylesheet" 
        href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css"
    >

    <!-- Font Awesome icons -->
    <script 
        src="https://use.fontawesome.com/releases/v5.15.1/js/all.js" 
        crossorigin="anonymous">
    </script>

    <!-- CampQuest home page styles -->
    <link rel="stylesheet" href="/stylesheets/home.css">

</head>

<body class="d-flex text-center text-white bg-dark">

    <div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">

        <!-- Home page navigation -->
        <header class="mb-auto">

            <div>

                <h3 class="float-md-left mb-0">
                    CampQuest
                </h3>

                <nav class="nav nav-masthead justify-content-center float-md-right">

                    <a class="nav-link active" href="/">
                        Home
                    </a>

                    <a class="nav-link" href="/campgrounds">
                        Campgrounds
                    </a>

                    <!-- Show login/register when user is logged out -->
                    <% if (!currentUser) { %>

                        <a class="nav-link" href="/login">
                            Login
                        </a>

                        <a class="nav-link" href="/register">
                            Register
                        </a>

                    <% } else { %>

                        <!-- Show logout when user is logged in -->
                        <a class="nav-link" href="/logout">
                            Logout
                        </a>

                    <% } %>

                </nav>

            </div>

        </header>


        <!-- Main home page content -->
        <main class="px-3">

            <h1>CampQuest</h1>

            <p class="lead">
                Your next adventure starts here.
                <br>
                Discover campgrounds, share hidden gems, and explore the outdoors with CampQuest.
            </p>

            <a 
                href="/campgrounds" 
                class="btn btn-lg btn-secondary font-weight-bold border-white bg-white">
                View Campgrounds
            </a>

        </main>


        <!-- Home page footer -->
        <footer class="mt-auto text-white-50">

            <p>
                CampQuest
            </p>

        </footer>

    </div>


    <!-- Bootstrap JavaScript dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>